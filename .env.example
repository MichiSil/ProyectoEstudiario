# Copiar este archivo a .env y completar los valores locales.
# El .env está en el .gitignore: los secretos reales nunca se suben al repositorio.

# ---------------------------------------------------------------
# planner-service: agente de IA (proveedor Groq, API compatible con OpenAI)
# ---------------------------------------------------------------
# Clave de la API de Groq (https://console.groq.com/keys). Si queda vacía,
# los planes se arman sólo con el motor de reglas.
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
# Presupuesto total de la llamada a la IA, reintento incluido (ADR-005).
AI_TIMEOUT=8s
