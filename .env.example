# ---------------------------------------------------------------
# Variables de entorno para levantar Estudiario en local.
#
#   cp .env.example .env
#
# Los valores de este archivo son SÓLO para desarrollo local: sirven
# para los contenedores que crea docker compose en tu máquina y no
# dan acceso a nada real. El archivo .env nunca se sube al repositorio.
# Las credenciales reales (proveedor de IA, servidor de mail, nube)
# se cargan únicamente en tu .env local o en los secretos de la
# plataforma de despliegue.
# ---------------------------------------------------------------

# --- PostgreSQL (users-service y planner-service) ---------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-local
USERS_DB_PASSWORD=users-local
PLANNER_DB_PASSWORD=planner-local

# --- MongoDB (forum-service y notification-service) -------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo-local
FORUM_DB_PASSWORD=forum-local
NOTIFICATIONS_DB_PASSWORD=notifications-local

# --- MinIO (PDF de los resúmenes) -------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=minio-local-admin
# Usuario propio de forum-service (mínimo 8 caracteres)
FORUM_MINIO_ACCESS_KEY=forum-service
FORUM_MINIO_SECRET_KEY=forum-minio-local

# --- RabbitMQ ---------------------------------------------------
RABBITMQ_USER=estudiario
RABBITMQ_PASSWORD=rabbit-local

# --- Autenticación ----------------------------------------------
# Clave para firmar los JWT. En la nube se usa una distinta y secreta.
JWT_SECRET=solo-para-desarrollo-local-cambiar-en-la-nube

# API keys aceptadas por la capacidad publicada (docs/contracts/),
# separadas por coma. Las de los grupos consumidores reales NO van acá.
PLANNER_EXTERNAL_API_KEYS=clave-local-de-prueba

# --- Proveedor de IA (planner-service) --------------------------
# Si AI_API_KEY queda vacía, el plan se arma con el motor de reglas (RN-09).
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=

# --- Servidor de mail (notification-service) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Estudiario <no-reply@estudiario.local>
