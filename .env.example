# ---------------------------------------------------------------
# Variables de entorno para levantar Estudiario en local.
#
#   cp .env.example .env
#
# Los valores de este archivo son SÓLO para desarrollo local: sirven
# para los contenedores que crea docker compose en tu máquina y no
# dan acceso a nada real. El archivo .env nunca se sube al repositorio.
# Las credenciales reales (proveedor de IA, nube) se cargan únicamente
# en tu .env local o en los secretos de la plataforma de despliegue.
# ---------------------------------------------------------------

# --- PostgreSQL (base planner de planner-service) ---------------
PLANNER_DB_USER=planner_svc
PLANNER_DB_PASSWORD=planner-local

# --- PostgreSQL (base users de users-service) -------------------
# Usuario propio de users-service: sólo puede entrar a la base users.
USERS_DB_USER=users_svc
USERS_DB_PASSWORD=users-local

# ---------------------------------------------------------------
# Identidad (api-gateway, users-service y planner-service)
# ---------------------------------------------------------------
# Secreto con el que se firman y validan los JWT (HS256). Mínimo 32
# caracteres. Con este mismo valor se generan tokens de prueba:
#   cd services/api-gateway && JWT_SECRET=... go run ./cmd/devtoken -sub estudiante-1
JWT_SECRET=solo-para-desarrollo-local-jwt-0123456789
# Secreto que el api-gateway le manda a planner-service para que acepte
# la identidad del estudiante. Mínimo 32 caracteres.
INTERNAL_TOKEN=solo-para-desarrollo-local-interno-0123456789
# En la nube, generá valores nuevos y aleatorios, por ejemplo con:
#   openssl rand -hex 32

# Mails que reciben el rol admin al registrarse en users-service (RF-03: el rol
# no se elige, se asigna por configuración). Separados por coma.
ADMIN_EMAILS=admin@estudiario.local

# ---------------------------------------------------------------
# planner-service: agente de IA (proveedor Groq, API compatible con OpenAI)
# ---------------------------------------------------------------
# Clave de la API de Groq (https://console.groq.com/keys). Si queda vacía,
# los planes se arman sólo con el motor de reglas (RN-09).
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
# Presupuesto total de la llamada a la IA, reintento incluido (ADR-005).
AI_TIMEOUT=8s
