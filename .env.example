# ---------------------------------------------------------------
# Variables de entorno para levantar Estudiario en local.
#
#   cp .env.example .env
#
# Los valores de este archivo son SÓLO para desarrollo local: sirven
# para los contenedores que crea docker compose en tu máquina y no
# dan acceso a nada real. El archivo .env nunca se sube al repositorio.
# Las credenciales reales (proveedor de IA, nube) se cargan únicamente
# en tu .env local o en los secretos de la plataforma de despliegue.
# ---------------------------------------------------------------

# --- PostgreSQL: administrador del contenedor -------------------
# Sólo lo usa el contenedor db-init para crear las bases y sus usuarios;
# ningún servicio se conecta con él. Se llama planner_svc porque así lo
# crearon los volúmenes de antes: no lo cambies si ya tenías la base.
POSTGRES_ADMIN_USER=planner_svc
POSTGRES_ADMIN_PASSWORD=planner-local

# --- PostgreSQL (base planner de planner-service) ---------------
# Usuario propio de planner-service: sólo puede entrar a la base planner.
PLANNER_DB_USER=planner_app
PLANNER_DB_PASSWORD=planner-app-local

# --- PostgreSQL (base users de users-service) -------------------
# Usuario propio de users-service: sólo puede entrar a la base users.
USERS_DB_USER=users_svc
USERS_DB_PASSWORD=users-local

# --- MongoDB (base forum de forum-service) ----------------------
# Administrador del contenedor: sólo lo usa mongo-init.
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=mongo-admin-local
# Usuario propio de forum-service: sólo lee y escribe la base forum.
FORUM_DB_USER=forum_svc
FORUM_DB_PASSWORD=forum-local

# --- MinIO (PDF de los resúmenes, bucket summaries) -------------
# Administrador del contenedor: sólo lo usa minio-init. Consola web en
# http://localhost:9001 con este usuario.
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio-admin-local
# Usuario propio de forum-service: sólo puede usar el bucket summaries.
FORUM_MINIO_ACCESS_KEY=forum-service
FORUM_MINIO_SECRET_KEY=forum-minio-local

# --- Capacidad /v1 de forum-service (ADR-014) -------------------
# API keys de los sistemas consumidores, como consumidor:hash, separadas por
# coma. Se guarda SÓLO el hash SHA-256 de cada clave, nunca la clave:
#   printf '%s' 'la-clave' | shasum -a 256
# El valor de abajo es el hash de la clave de prueba local
# "clave-de-prueba-grupo4". La clave real del Grupo 4 se genera aparte, se le
# entrega por un canal privado y su hash va sólo en el .env de la nube.
FORUM_API_KEYS=grupo4:01bcc01f34c9f358394fca4be4af4a2fbb80a0122fe52bf7bf120b2d29b99e1d

# --- Limpieza de PDF huérfanos de forum-service (ADR-003) --------
# Cada cuánto corre y desde qué antigüedad borra un PDF del bucket que no
# tiene ningún resumen. La antigüedad evita borrar uno que se está subiendo.
# Para probarlo se pueden bajar, por ejemplo a 30s y 0s.
FORUM_CLEANUP_INTERVAL=1h
FORUM_CLEANUP_MIN_AGE=1h

# ---------------------------------------------------------------
# Identidad (api-gateway, users-service y planner-service)
# ---------------------------------------------------------------
# Secreto con el que se firman y validan los JWT (HS256). Mínimo 32
# caracteres. Con este mismo valor se generan tokens de prueba:
#   cd services/api-gateway && JWT_SECRET=... go run ./cmd/devtoken -sub estudiante-1
JWT_SECRET=solo-para-desarrollo-local-jwt-0123456789
# Secreto que el api-gateway le manda a planner-service para que acepte
# la identidad del estudiante. Mínimo 32 caracteres.
INTERNAL_TOKEN=solo-para-desarrollo-local-interno-0123456789
# En la nube, generá valores nuevos y aleatorios, por ejemplo con:
#   openssl rand -hex 32

# Mails con rol admin en users-service (RF-03: el rol no se elige, se asigna por
# configuración). Separados por coma. Se aplica al registrarse y en cada login.
ADMIN_EMAILS=admin@estudiario.local

# ---------------------------------------------------------------
# planner-service: agente de IA (proveedor Groq, API compatible con OpenAI)
# ---------------------------------------------------------------
# Clave de la API de Groq (https://console.groq.com/keys). Si queda vacía,
# los planes se arman sólo con el motor de reglas (RN-09).
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
# Presupuesto total de la llamada a la IA, reintento incluido (ADR-005).
AI_TIMEOUT=8s
